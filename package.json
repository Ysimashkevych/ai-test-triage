{
  "name": "ai-test-triage",
  "version": "0.1.0",
  "description": "LLM-assisted triage of Playwright test failures (product-bug / flaky-test / environment / test-bug) with a heuristic baseline.",
  "type": "module",
  "license": "MIT",
  "author": "Yurii Simashkevych",
  "bin": {
    "ai-test-triage": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/prompts','dist/prompts',{recursive:true,filter:s=>!s.endsWith('.ts')})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "triage": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
